@@ -0,0 +1,106 @@
+package com.shilapi.xcertplay.hud
+
+import android.content.pm.ApplicationInfo
+import android.content.pm.PackageInfo
+import com.shilapi.xcertplay.iap2.wire.Iap2Frame
+import java.io.ByteArrayOutputStream
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import org.robolectric.shadows.ShadowBuild
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], manifest = Config.NONE)
+class SealNavigationAdapterTest {
+    private val context get() = RuntimeEnvironment.getApplication()
+
+    private fun installLegacy(system: Boolean = true, version: Int = 10502002) {
+        ShadowBuild.setFingerprint("BYD-AUTO/DiLink4.0/DiLink4.0:10/QKQ1.210218.001/eng.build.20260122.001308:user/release-keys")
+        val info = PackageInfo().apply {
+            packageName = "com.example.amapservice"
+            setLongVersionCode(version.toLong())
+            applicationInfo = ApplicationInfo().apply {
+                packageName = infoPackage
+                flags = if (system) ApplicationInfo.FLAG_SYSTEM else 0
+            }
+        }
+        shadowOf(context.packageManager).installPackage(info)
+    }
+
+    @Test fun installedSealFactoryAdapterMakesNavigationSettingsAvailable() {
+        installLegacy()
+        assertEquals("com.example.amapservice", BydAmapAdapter.resolve(context))
+        assertTrue("The owner's factory adapter must expose the navigation setting", BydOutputSettings.available(context))
+    }
+
+    @Test fun absentAdapterDoesNotExposeUnsupportedNavigation() {
+        assertFalse(BydOutputSettings.available(context))
+    }
+
+    @Test fun thirdPartyPackageWithSameNameIsNotUsed() {
+        installLegacy(system = false)
+        assertFalse(BydOutputSettings.available(context))
+    }
+
+    @Test fun uninspectedFactoryVersionIsNotEnabled() {
+        installLegacy(version = 1)
+        assertFalse(BydOutputSettings.available(context))
+    }
+
+    @Test fun differentFirmwareIsNotEnabledByThisProfile() {
+        installLegacy()
+        ShadowBuild.setFingerprint("another-firmware")
+        assertFalse(BydOutputSettings.available(context))
+    }
+
+    @Test fun sealInstrumentReceivesTextDistancesAndTimeWithoutMinusOnePlaceholders() {
+        installLegacy()
+        BydOutputSettings.setEnabled(context, true)
+        BydClusterBridge.initialize(context)
+        try {
+            BydClusterBridge.onFrame(Iap2Frame(0x5202, parameters(
+                parameter(1, 0, 1), parameter(3, 2),
+                parameter(4, *"测试道路\u0000".toByteArray().map { it.toInt() and 255 }.toIntArray()),
+            )))
+            // The phone has not supplied totals yet. The cluster must show blanks, not -1.
+            BydClusterBridge.onFrame(Iap2Frame(0x5201, parameters(
+                parameter(1, 1), parameter(10, 0, 0, 0, 150), parameter(13, 0, 1),
+            )))
+            var sent = shadowOf(context).broadcastIntents.last { it.getIntExtra("KEY_TYPE", 0) == 10001 }
+            assertEquals("com.example.amapservice", sent.`package`)
+            assertEquals(150, sent.getIntExtra("SEG_REMAIN_DIS", -1))
+            assertEquals("150米", sent.getStringExtra("SEG_REMAIN_DIS_AUTO"))
+            assertEquals("", sent.getStringExtra("ROUTE_REMAIN_DIS_AUTO"))
+            assertEquals("", sent.getStringExtra("ROUTE_REMAIN_TIME_AUTO"))
+
+            BydClusterBridge.onFrame(Iap2Frame(0x5201, parameters(
+                parameter(6, 0, 0, 0, 0, 0, 0, 2, 89), // 601 seconds
+                parameter(7, 0, 0, 5, 220), // 1500 meters
+            )))
+            sent = shadowOf(context).broadcastIntents.last { it.getIntExtra("KEY_TYPE", 0) == 10001 }
+            assertEquals(1500, sent.getIntExtra("ROUTE_REMAIN_DIS", -1))
+            assertEquals(601, sent.getIntExtra("ROUTE_REMAIN_TIME", -1))
+            assertEquals("1.5公里", sent.getStringExtra("ROUTE_REMAIN_DIS_AUTO"))
+            assertEquals("11分钟", sent.getStringExtra("ROUTE_REMAIN_TIME_AUTO"))
+
+            BydClusterBridge.onFrame(Iap2Frame(0x5201, parameter(1, 2)))
+            assertEquals(9, shadowOf(context).broadcastIntents.last().getIntExtra("EXTRA_STATE", -1))
+        } finally {
+            BydClusterBridge.clear()
+        }
+    }
+
+    private fun parameter(id: Int, vararg values: Int): ByteArray = ByteArrayOutputStream().apply {
+        write((values.size + 4) ushr 8); write(values.size + 4)
+        write(id ushr 8); write(id)
+        values.forEach(::write)
+    }.toByteArray()
+
+    private fun parameters(vararg values: ByteArray): ByteArray = values.fold(byteArrayOf()) { a, b -> a + b }
+
+    companion object { private const val infoPackage = "com.example.amapservice" }
+}
