@@ -0,0 +1,25 @@
+package com.shilapi.xcertplay.hud
+
+import android.content.Context
+import android.content.pm.ApplicationInfo
+import android.os.Build
+
+/** Select the stock receiver; the legacy profile is limited to the inspected Seal firmware. */
+internal object BydAmapAdapter {
+    private const val MODERN = "com.byd.amapservice"
+    private const val SEAL = "com.example.amapservice"
+    private const val SEAL_FIRMWARE = "BYD-AUTO/DiLink4.0/DiLink4.0:10/QKQ1.210218.001/eng.build.20260122.001308:user/release-keys"
+
+    fun resolve(context: Context): String? {
+        val manager = context.packageManager
+        if (runCatching { manager.getPackageInfo(MODERN, 0) }.isSuccess) return MODERN
+        if (Build.FINGERPRINT != SEAL_FIRMWARE) return null
+        return runCatching {
+            val info = manager.getPackageInfo(SEAL, 0)
+            SEAL.takeIf {
+                info.longVersionCode == 10502002L &&
+                    (info.applicationInfo?.flags ?: 0) and ApplicationInfo.FLAG_SYSTEM != 0
+            }
+        }.getOrNull()
+    }
+}
